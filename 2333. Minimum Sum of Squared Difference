class Solution {
public:
    long long minSumSquareDiff(vector<int>& nums1, vector<int>& nums2, int k1, int k2) {
        int n = nums1.size();
        long long k = 1LL * k1 + k2;
        vector<int> diff(n);

        long long total = 0;
        int mx = 0;

        for(int i = 0; i < n; i++) {
            diff[i] = abs(nums1[i] - nums2[i]);
            total += diff[i];
            mx = max(mx, diff[i]);
        }

        if(k >= total)
            return 0;

        vector<long long> freq(mx + 1, 0);

        for(int d : diff)
            freq[d]++;

        for(int d = mx; d > 0 && k > 0; d--) {
            long long count = freq[d];
            long long cost = count;

            if(k >= cost) {
                freq[d - 1] += count;
                freq[d] = 0;
                k -= cost;
            } else {
                long long reduce = k / count;
                long long rem = k % count;

                freq[d] -= count;
                freq[d - reduce] += count - rem;
                freq[d - reduce - 1] += rem;
                k = 0;
            }
        }

        long long ans = 0;

        for(int d = 1; d <= mx; d++)
            ans += 1LL * d * d * freq[d];

        return ans;
    }
};
