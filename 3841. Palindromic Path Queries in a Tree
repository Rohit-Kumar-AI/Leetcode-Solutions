class Solution {
    struct Fenwick {
        int n;
        vector<int> bit;

        Fenwick(int n) : n(n), bit(n + 2, 0) {}

        void update(int i, int val) {
            for (++i; i <= n; i += i & -i)
                bit[i] ^= val;
        }

        int query(int i) {
            int res = 0;
            for (++i; i > 0; i -= i & -i)
                res ^= bit[i];
            return res;
        }

        void rangeXor(int l, int r, int val) {
            update(l, val);
            if (r + 1 < n)
                update(r + 1, val);
        }
    };

public:
    vector<bool> palindromePath(int n, vector<vector<int>>& edges,
                                string s, vector<string>& queries) {
        vector<vector<int>> adj(n);

        for (auto& e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        int LOG = 1;
        while ((1 << LOG) <= n) LOG++;

        vector<vector<int>> up(LOG, vector<int>(n));
        vector<int> parent(n, -1), depth(n, 0);
        vector<int> tin(n), tout(n), pref(n), order;

        vector<int> st = {0};
        parent[0] = 0;
        pref[0] = 1 << (s[0] - 'a');

        while (!st.empty()) {
            int u = st.back();
            st.pop_back();

            tin[u] = order.size();
            order.push_back(u);

            for (int v : adj[u]) {
                if (parent[v] != -1) continue;

                parent[v] = u;
                depth[v] = depth[u] + 1;
                pref[v] = pref[u] ^ (1 << (s[v] - 'a'));
                st.push_back(v);
            }
        }

        vector<int> sz(n, 1);

        for (int i = n - 1; i > 0; i--) {
            int u = order[i];
            sz[parent[u]] += sz[u];
        }

        for (int u = 0; u < n; u++)
            tout[u] = tin[u] + sz[u] - 1;

        for (int u = 0; u < n; u++)
            up[0][u] = parent[u];

        for (int j = 1; j < LOG; j++) {
            for (int u = 0; u < n; u++)
                up[j][u] = up[j - 1][up[j - 1][u]];
        }

        auto lca = [&](int u, int v) {
            if (depth[u] < depth[v]) swap(u, v);

            int diff = depth[u] - depth[v];

            for (int j = 0; j < LOG; j++)
                if (diff & (1 << j))
                    u = up[j][u];

            if (u == v) return u;

            for (int j = LOG - 1; j >= 0; j--) {
                if (up[j][u] != up[j][v]) {
                    u = up[j][u];
                    v = up[j][v];
                }
            }

            return parent[u];
        };

        Fenwick fw(n);

        auto getPrefix = [&](int u) {
            return pref[u] ^ fw.query(tin[u]);
        };

        vector<bool> ans;

        for (string& q : queries) {
            stringstream ss(q);
            string type, a, b;
            ss >> type >> a >> b;

            int u = stoi(a);

            if (type == "update") {
                char c = b[0];

                int delta = (1 << (s[u] - 'a')) ^ (1 << (c - 'a'));

                s[u] = c;
                fw.rangeXor(tin[u], tout[u], delta);
            } else {
                int v = stoi(b);
                int w = lca(u, v);

                int mask = getPrefix(u) ^ getPrefix(v)
                         ^ (1 << (s[w] - 'a'));

                ans.push_back((mask & (mask - 1)) == 0);
            }
        }

        return ans;
    }
};
