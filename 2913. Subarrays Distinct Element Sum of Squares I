class Solution {
public:
    int sumCounts(vector<int>& nums) {
        int n = nums.size();
        int ans = 0;
        const int MOD = 1e9 + 7;

        for(int i = 0; i < n; i++) {
            unordered_set<int> st;

            for(int j = i; j < n; j++) {
                st.insert(nums[j]);

                int distinct = st.size();
                ans = (ans + 1LL * distinct * distinct) % MOD;
            }
        }

        return ans;
    }
};
