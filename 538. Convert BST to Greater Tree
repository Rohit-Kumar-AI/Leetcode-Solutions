class Solution {
public:
    TreeNode* convertBST(TreeNode* root) {
        stack<TreeNode*> st;
        TreeNode* curr = root;
        int sum = 0;

        while (curr || !st.empty()) {
            if (curr) {
                st.push(curr);
                curr = curr->right;
            } else {
                curr = st.top();
                st.pop();

                sum += curr->val;
                curr->val = sum;

                curr = curr->left;
            }
        }

        return root;
    }
};
