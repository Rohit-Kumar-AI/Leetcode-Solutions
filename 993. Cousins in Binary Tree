class Solution {
public:
    bool isCousins(TreeNode* root, int x, int y) {
        queue<pair<TreeNode*, TreeNode*>> q;
        q.push({root, NULL});

        TreeNode* parentX = NULL;
        TreeNode* parentY = NULL;
        int xdepth = -1;
        int ydepth = -1;
        int depth = 0;

        while (!q.empty()) {
            int n = q.size();

            while (n--) {
                pair<TreeNode*, TreeNode*> p = q.front();
                q.pop();

                TreeNode* node = p.first;
                TreeNode* parent = p.second;

                if (node->val == x) {
                    parentX = parent;
                    xdepth = depth;
                }

                if (node->val == y) {
                    parentY = parent;
                    ydepth = depth;
                }

                if (node->left)
                    q.push({node->left, node});

                if (node->right)
                    q.push({node->right, node});
            }

            depth++;
        }

        return xdepth == ydepth && parentX != parentY;
    }
};
