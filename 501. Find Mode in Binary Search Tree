class Solution {
public:
    vector<int> ans;
    int prev = 0;
    int count = 0;
    int maxi = 0;
    bool first = true;

    void inorder(TreeNode* root)
    {
        if(root == NULL)
            return;

        inorder(root->left);

        if(first || root->val == prev)
            count++;
        else
            count = 1;

        if(count > maxi)
        {
            maxi = count;
            ans.clear();
            ans.push_back(root->val);
        }
        else if(count == maxi)
        {
            ans.push_back(root->val);
        }

        prev = root->val;
        first = false;

        inorder(root->right);
    }

    vector<int> findMode(TreeNode* root)
    {
        inorder(root);
        return ans;
    }
};
