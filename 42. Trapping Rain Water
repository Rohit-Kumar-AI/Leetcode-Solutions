class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        if (n == 0) return 0;

        vector<int> prev(n), next(n), mini(n);

        prev[0] = -1;
        int mx = height[0];

        for (int i = 1; i < n; i++) {
            prev[i] = mx;
            mx = max(mx, height[i]);
        }

        next[n - 1] = -1;
        mx = height[n - 1];

        for (int i = n - 2; i >= 0; i--) {
            next[i] = mx;
            mx = max(mx, height[i]);
        }

        int water = 0;

        for (int i = 0; i < n; i++) {
            mini[i] = min(prev[i], next[i]);

            if (height[i] < mini[i])
                water += mini[i] - height[i];
        }

        return water;
    }
};
